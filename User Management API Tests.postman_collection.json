          "name": "Get All Users",
          "item": [
            {
              "name": "Get Users",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is an array\", function () {\r\n    const users = pm.response.json();\r\n    pm.expect(users).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"User list is not empty\", function () {\r\n    const users = pm.response.json();\r\n    pm.expect(users.length).to.be.above(0);\r\n})\r\n\r\npm.test(\"Each user has an id and name\", function () {\r\n    const users = pm.response.json();\r\n    users.forEach(function (user) {\r\n        pm.expect(user).to.have.property(\"id\");\r\n        pm.expect(user).to.have.property(\"name\");\r\n    });\r\n}); "
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/users",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "users"
                  ]
                }
              },
              "response": []
            }
          ]
        },
