                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Created user has a name\", function () {\r\n    const user = pm.response.json();\r\n    pm.expect(user).to.have.property(\"name\"); \r\n});\r\n\r\npm.test(\"Created user name matches request\", function () {\r\n    const user = pm.response.json();\r\n    pm.expect(user.name).to.equal(\"Brian Cabingan\");\r\n});\r\n\r\nconst createdUser = pm.response.json();\r\n\r\npm.collectionVariables.set(\"createdUserID\", createdUser.id); \r\n\r\npm.test(\"Created user ID was saved\", function () {\r\n    pm.expect(pm.collectionVariables.get(\"createdUserID\")).to.exist;\r\n});\r\n"
